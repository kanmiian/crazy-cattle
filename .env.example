# Cloudflare Worker secrets. Configure these with `wrangler secret put`; never
# expose them through VITE_* variables or commit their real values.
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Set only during a planned rotation, then remove after Feishu uses the new key.
FEISHU_VERIFICATION_TOKEN_PREVIOUS=
FEISHU_ENCRYPT_KEY_PREVIOUS=
GITHUB_TOKEN=

# Cloudflare Worker non-secret variables (wrangler.toml already has defaults).
GITHUB_OWNER=kanmiian
GITHUB_REPO=crazy-cattle
GITHUB_EVENT_TYPE=feishu_game_submission
REQUIRE_ENCRYPTION=true
REPLAY_TTL_SECONDS=86400

# Optional GitHub Actions repository secrets used to report the PR back to Feishu.
FEISHU_APP_ID=
FEISHU_APP_SECRET=
